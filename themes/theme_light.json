{
  "variables": {
    "--bg": "#F3F6FBFF",
    "--surface": "#FFFFFFFF",
    "--surface-alt": "#EDF2F9FF",
    "--field": "#FFFFFFFF",
    "--line": "#CBD5E1FF",
    "--text": "#1F2937FF",
    "--muted": "#64748BFF",
    "--primary": "#2D7FF9FF",
    "--primary-hover": "#4A90D9FF",
    "--primary-pressed": "#2563B8FF",
    "--danger": "#DC5A5AFF",
    "--danger-hover": "#C94B4BFF",
    "--disabled": "#E2E8F0FF"
  },
  "styles": [
    {
      "selector": "panel",
      "declarations": { "background": "var(--bg)" }
    },
    {
      "selector": "panel.card",
      "declarations": {
        "background": "var(--surface)", "border-color": "var(--line)",
        "border-visible": true, "border-radius": 12,
        "content-padding": "16",
        "box-shadow": { "color": "#1F29371A", "offset-x": 0, "offset-y": 6,
                        "blur": 18, "spread": 0 }
      }
    },
    {
      "selector": "label",
      "declarations": { "text-color": "var(--text)" }
    },
    {
      "selector": "label.title",
      "declarations": { "text-color": "var(--text)", "font-size": 24 }
    },
    {
      "selector": "label.muted",
      "declarations": { "text-color": "var(--muted)", "font-size": 13 }
    },
    {
      "selector": "button",
      "declarations": {
        "background": "var(--primary)", "text-color": "#FFFFFFFF",
        "border-color": "#2D7FF9", "border-visible": true,
        "border-radius": 8, "content-padding": "8 16", "font-size": 15
      }
    },
    {
      "selector": "button:hover",
      "declarations": { "background": "var(--primary-hover)" }
    },
    {
      "selector": "button:pressed",
      "declarations": { "background": "var(--primary-pressed)" }
    },
    {
      "selector": "button:disabled",
      "declarations": {
        "background": "var(--disabled)", "text-color": "var(--muted)",
        "border-color": "var(--line)"
      }
    },
    {
      "selector": "button.secondary",
      "declarations": {
        "background": "var(--surface-alt)", "text-color": "var(--text)",
        "border-color": "var(--line)", "border-visible": true
      }
    },
    {
      "selector": "button.secondary:hover",
      "declarations": { "background": "#E1E8F2FF" }
    },
    {
      "selector": "button.danger",
      "declarations": {
        "background": "var(--danger)", "text-color": "#FFFFFFFF",
        "border-color": "#C94B4BFF"
      }
    },
    {
      "selector": "button.danger:hover",
      "declarations": { "background": "var(--danger-hover)" }
    },
    {
      "selector": "edit-box",
      "declarations": {
        "background": "var(--field)", "text-color": "var(--text)",
        "border-color": "var(--line)", "border-visible": true,
        "border-radius": 6, "content-padding": "7 10"
      }
    },
    {
      "selector": "text-area",
      "declarations": {
        "background": "var(--field)", "text-color": "var(--text)",
        "border-color": "var(--line)", "border-visible": true,
        "border-radius": 6, "content-padding": "7 10"
      }
    },
    {
      "selector": "combo-box",
      "declarations": {
        "background": "var(--field)", "text-color": "var(--text)",
        "border-color": "var(--line)", "border-visible": true,
        "border-radius": 6
      }
    },
    {
      "selector": "numeric-up-down",
      "declarations": {
        "background": "var(--field)", "text-color": "var(--text)",
        "border-color": "var(--line)", "border-visible": true,
        "border-radius": 6
      }
    },
    {
      "selector": "color-picker",
      "declarations": {
        "background": "var(--surface-alt)", "text-color": "var(--text)",
        "border-color": "var(--line)", "border-visible": true,
        "border-radius": 6
      }
    },
    {
      "selector": "check-box",
      "declarations": { "text-color": "var(--text)" }
    },
    {
      "selector": "list-view",
      "declarations": {
        "background": "var(--surface)", "text-color": "var(--text)",
        "border-color": "var(--line)", "border-visible": true,
        "header-background": "var(--surface-alt)"
      }
    },
    {
      "selector": "tree-view",
      "declarations": {
        "background": "var(--surface)", "text-color": "var(--text)",
        "border-color": "var(--line)", "border-visible": true,
        "header-background": "var(--surface-alt)"
      }
    },
    {
      "selector": "tab-control",
      "declarations": { "background": "var(--surface)", "text-color": "var(--text)" }
    },
    {
      "selector": "menu-bar",
      "declarations": { "background": "var(--surface-alt)", "text-color": "var(--text)" }
    },
    {
      "selector": "status-bar",
      "declarations": { "background": "var(--surface-alt)", "text-color": "var(--muted)" }
    },
    {
      "selector": "splitter",
      "declarations": { "background": "var(--line)" }
    }
  ]
}
